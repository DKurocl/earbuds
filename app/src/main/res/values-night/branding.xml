<resources>
    <style name="Theme.Hush" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- The page color of the app (wallpaper colors), so the start shows no other color. -->
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <!-- The launcher icon itself, in its circle: the case drops in, its copy settles under it, its lid lifts once (docs/icon/brand_icon.py). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFFFF</item>
        <item name="android:windowSplashScreenAnimationDuration">580</item>
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
    </style>
</resources>
