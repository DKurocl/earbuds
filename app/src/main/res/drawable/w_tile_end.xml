<?xml version="1.0" encoding="utf-8"?>
<!-- Connected group segment. Concrete radii only: 999dp next to 16dp makes Android scale every corner down, and the inner joints turn square. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/w_ripple">
    <item><shape android:shape="rectangle"><solid android:color="@color/w_off" /><corners android:topLeftRadius="16dp" android:topRightRadius="28dp" android:bottomRightRadius="28dp" android:bottomLeftRadius="16dp" /></shape></item>
    <item android:id="@android:id/mask"><shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:topLeftRadius="16dp" android:topRightRadius="28dp" android:bottomRightRadius="28dp" android:bottomLeftRadius="16dp" /></shape></item>
</ripple>
