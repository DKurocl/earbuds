<?xml version="1.0" encoding="utf-8"?>
<!-- Large slots (lock screen hub, 4×2 and up). Header: name and status. The middle takes all the
     height left: how long you can listen, big, beside the three battery rings. Modes at the bottom.
     WidgetLayout.dashboard sizes the rings, the big number and the buttons for each slot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:padding="16dp">
<LinearLayout android:id="@+id/w_group"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="google-sans-text-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textSize="16sp" android:textColor="@color/w_off_text" android:text="@string/w_device" />
        <TextView android:id="@+id/w_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
            android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_batteries" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginVertical="12dp"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingEnd="8dp" tools:ignore="RtlSymmetry">
            <TextView android:id="@+id/w_hero"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="google-sans-medium" android:includeFontPadding="false" android:singleLine="true"
                android:textSize="30sp" android:textColor="@color/w_off_text" />
            <TextView android:id="@+id/w_hero_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="4dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/w_sub_text" />
            <TextView android:id="@+id/w_estimate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="2dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/w_sub_text" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/w_left"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:id="@+id/w_left_box"
                    android:layout_width="56dp" android:layout_height="56dp">
                    <ProgressBar android:id="@+id/w_left_ring"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/w_ring" />
                    <ImageView android:id="@+id/w_left_art"
                        android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                        android:background="@drawable/w_disc" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/w_glyph_bud_left" android:tint="@color/w_glyph" />
                    <ImageView android:id="@+id/w_left_charge"
                        android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/w_badge" android:padding="3dp" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_bolt" android:visibility="gone" />
                </FrameLayout>
                <TextView android:id="@+id/w_left_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="6dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="14sp" android:textColor="@color/w_off_text"
                    android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_left_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text" android:includeFontPadding="false" android:singleLine="true"
                    android:textSize="11sp" android:textColor="@color/w_sub_text" android:visibility="gone"
                    android:importantForAccessibility="no" android:text="@string/w_left" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_case"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:id="@+id/w_case_box"
                    android:layout_width="56dp" android:layout_height="56dp">
                    <ProgressBar android:id="@+id/w_case_ring"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/w_ring" />
                    <ImageView android:id="@+id/w_case_art"
                        android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                        android:background="@drawable/w_disc" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/ic_case_mark" android:tint="@color/w_glyph" />
                    <ImageView android:id="@+id/w_case_charge"
                        android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/w_badge" android:padding="3dp" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_bolt" android:visibility="gone" />
                </FrameLayout>
                <TextView android:id="@+id/w_case_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="6dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="14sp" android:textColor="@color/w_off_text"
                    android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_case_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text" android:includeFontPadding="false" android:singleLine="true"
                    android:textSize="11sp" android:textColor="@color/w_sub_text" android:visibility="gone"
                    android:importantForAccessibility="no" android:text="@string/w_case" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_right"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:gravity="center_horizontal" android:orientation="vertical">
                <FrameLayout android:id="@+id/w_right_box"
                    android:layout_width="56dp" android:layout_height="56dp">
                    <ProgressBar android:id="@+id/w_right_ring"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:indeterminate="false" android:max="100" android:progress="0"
                        android:progressDrawable="@drawable/w_ring" />
                    <ImageView android:id="@+id/w_right_art"
                        android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                        android:background="@drawable/w_disc" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/w_glyph_bud_right" android:tint="@color/w_glyph" />
                    <ImageView android:id="@+id/w_right_charge"
                        android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/w_badge" android:padding="3dp" android:scaleType="fitCenter"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_bolt" android:visibility="gone" />
                </FrameLayout>
                <TextView android:id="@+id/w_right_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="6dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="14sp" android:textColor="@color/w_off_text"
                    android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_right_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text" android:includeFontPadding="false" android:singleLine="true"
                    android:textSize="11sp" android:textColor="@color/w_sub_text" android:visibility="gone"
                    android:importantForAccessibility="no" android:text="@string/w_right" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- The mode row is generated by docs/widget/segments.py: the chosen mode is disabled and morphs into a pill. -->
    <LinearLayout android:id="@+id/w_modes" android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:baselineAligned="false">
<!-- modes:start -->
        <FrameLayout android:id="@+id/w_anc"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:duplicateParentState="true">
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_l_oo" />
                <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_mid" />
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_r_ii" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_anc_content"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
                android:duplicateParentState="true">
                <FrameLayout android:id="@+id/w_anc_icon"
                    android:layout_width="24dp" android:layout_height="24dp" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_not_chosen"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_noise_control_off" android:tint="@color/w_on" />
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_chosen" android:alpha="0"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_noise_control_off" android:tint="@color/w_on_text" />
                </FrameLayout>
                <FrameLayout android:id="@+id/w_anc_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="8dp" tools:ignore="RtlSymmetry" android:duplicateParentState="true">
                    <TextView android:id="@+id/w_anc_label_off" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_not_chosen" android:textColor="@color/w_off_text"
                        android:text="@string/shortcut_anc" />
                    <TextView android:id="@+id/w_anc_label_on" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_chosen" android:alpha="0" android:textColor="@color/w_on_text"
                        android:text="@string/shortcut_anc" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_amb"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:duplicateParentState="true">
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_l_ii" />
                <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_mid" />
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_r_ii" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_amb_content"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
                android:duplicateParentState="true">
                <FrameLayout android:id="@+id/w_amb_icon"
                    android:layout_width="24dp" android:layout_height="24dp" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_not_chosen"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_hearing" android:tint="@color/w_on" />
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_chosen" android:alpha="0"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_hearing" android:tint="@color/w_on_text" />
                </FrameLayout>
                <FrameLayout android:id="@+id/w_amb_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="8dp" tools:ignore="RtlSymmetry" android:duplicateParentState="true">
                    <TextView android:id="@+id/w_amb_label_off" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_not_chosen" android:textColor="@color/w_off_text"
                        android:text="@string/shortcut_ambient" />
                    <TextView android:id="@+id/w_amb_label_on" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_chosen" android:alpha="0" android:textColor="@color/w_on_text"
                        android:text="@string/shortcut_ambient" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/w_off"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:duplicateParentState="true">
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_l_ii" />
                <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_mid" />
                <ImageView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:adjustViewBounds="true" android:scaleType="fitXY" android:duplicateParentState="true"
                    android:importantForAccessibility="no" android:src="@drawable/w_seg_r_oo" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_off_content"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
                android:duplicateParentState="true">
                <FrameLayout android:id="@+id/w_off_icon"
                    android:layout_width="24dp" android:layout_height="24dp" android:duplicateParentState="true">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_not_chosen"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_power_settings_new" android:tint="@color/w_on" />
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:duplicateParentState="true" android:stateListAnimator="@animator/w_while_chosen" android:alpha="0"
                        android:importantForAccessibility="no" android:src="@drawable/w_icon_power_settings_new" android:tint="@color/w_on_text" />
                </FrameLayout>
                <FrameLayout android:id="@+id/w_off_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="8dp" tools:ignore="RtlSymmetry" android:duplicateParentState="true">
                    <TextView android:id="@+id/w_off_label_off" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_not_chosen" android:textColor="@color/w_off_text"
                        android:text="@string/shortcut_off" />
                    <TextView android:id="@+id/w_off_label_on" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="google-sans-text-medium" android:textSize="14sp"
                        android:includeFontPadding="false" android:singleLine="true" android:ellipsize="none"
                        android:importantForAccessibility="no" android:duplicateParentState="true"
                        android:stateListAnimator="@animator/w_while_chosen" android:alpha="0" android:textColor="@color/w_on_text"
                        android:text="@string/shortcut_off" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <!-- modes:end -->
    </LinearLayout>
</LinearLayout>
</FrameLayout>
