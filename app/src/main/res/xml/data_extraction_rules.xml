<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to the cloud. Moving to a new phone (cable or Wi-Fi transfer during setup) brings
     the settings along: the earbuds, name, modes, equalizer cache, home and battery history. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sonyanc.xml" />
    </device-transfer>
</data-extraction-rules>
