<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The owner's Music app asks for things through this (MusicLinkReceiver); only apps signed
         with the same key may. -->
    <permission android:name="ua.olex.sonyanc.permission.CONTROL" android:protectionLevel="signature" />
    <!-- Android 8 to 11 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Mode-specific haptic compositions on the Pixel actuator. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- "Charge before you go": its one daily alarm is set again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Ambient while walking": the phone's step detector, only while the earbuds are connected. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
    <!-- Only for the opt-in case battery reminder; requested when it is turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "At home": compare the last known location with home when the earbuds connect. Coarse is
         enough for a 250 m circle; "all the time" because the connect happens in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 16+: the Ambient timer may show as a Live Update (status-bar chip). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- "Ambient for a moment" returns on time: one exact alarm, only while that timer runs.
         Sideloaded personal app, so the install-time permission is fine. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- "Stay in sync": Android binds LinkService while the companion earbuds are connected. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <!-- "Find" opens Google Find Hub, where the earbuds are registered. -->
    <queries>
        <package android:name="com.google.android.apps.adm" />
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Hush"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the Quick Settings tile to open the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Comes up over other apps when the earbuds connect (ConnectedSheet.kt). -->
        <activity
            android:name=".ConnectedSheetActivity"
            android:exported="false"
            android:theme="@style/Theme.Hush.Sheet"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />
        <service android:name=".NoiseTileService" android:label="Noise control"
            android:icon="@drawable/w_icon_anc" android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- App Functions for Gemini (EarbudsFunctions.kt; the service and schema are generated). -->
        <service android:name=".EarbudsFunctionService" android:exported="true"
            android:enabled="@bool/android16" tools:targetApi="36"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property android:name="android.app.appfunctions.schema" android:value="app_functions_schema.xsd" />
            <property android:name="android.app.appfunctions.v2" android:value="earbuds_functions.xml" />
            <intent-filter><action android:name="android.app.appfunctions.AppFunctionService" /></intent-filter>
        </service>
        <!-- Bound by Android only while the companion earbuds are connected (LiveLink). -->
        <service android:name=".LinkService" android:exported="true"
            android:enabled="@bool/android16" tools:targetApi="36"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter><action android:name="android.companion.CompanionDeviceService" /></intent-filter>
        </service>
        <receiver android:name=".AmbientTimerReceiver" android:exported="false" />
        <receiver android:name=".ChargeReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".MusicLinkReceiver" android:exported="true"
            android:permission="ua.olex.sonyanc.permission.CONTROL">
            <intent-filter>
                <action android:name="ua.olex.sonyanc.action.EQ_OFF" />
                <action android:name="ua.olex.sonyanc.action.SLEEP" />
            </intent-filter>
        </receiver>
        <receiver android:name=".LowBatteryReceiver" android:exported="false" />
        <!-- ACL broadcasts for the saved earbuds; exempt from implicit-broadcast limits. -->
        <receiver android:name=".ConnectionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BatteryWidget"
            android:exported="false"
            android:label="@string/widget_battery_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>
        <receiver
            android:name=".ModeWidget"
            android:exported="false"
            android:label="@string/widget_modes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_modes_info" />
        </receiver>
    </application>
</manifest>

