<!-- The launcher icon in Google's 2025 icon style: the earbud floats on the system's white plate
     (no tile of its own). Art in drawable-nodpi; the splash keeps its own mark (brand_icon.py). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_plate" />
    <foreground android:drawable="@drawable/ic_launcher_art" />
    <monochrome android:drawable="@drawable/ic_launcher_art_mono" />
</adaptive-icon>
