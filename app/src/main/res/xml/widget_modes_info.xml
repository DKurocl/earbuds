<?xml version="1.0" encoding="utf-8"?>
<!-- Every size is rendered exactly (ModeWidget.viewsFor); the system picks nothing by breakpoint. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="150dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_switch"
    android:previewLayout="@layout/widget_switch"
    android:description="@string/widget_desc"
    android:widgetCategory="home_screen|keyguard" />
