<resources>
    <style name="Theme.Hush" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- The same system surface used by the app with wallpaper colors enabled. -->
        <item name="android:windowBackground">@android:color/system_surface_dark</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_surface_dark</item>
        <!-- The launcher icon itself, in its circle: the case drops in, its copy settles under it, its lid lifts once (docs/icon/brand_icon.py). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_icon_background</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/brand_splash_duration</item>
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
    </style>
</resources>
