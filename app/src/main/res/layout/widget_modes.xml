<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg"
    android:padding="14dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_hush_mark"
        android:tint="@color/w_title"
        android:contentDescription="Hush" />
    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/w_title"
        android:text="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_anc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/w_tile_off"
            android:textColor="@color/w_off_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="ANC" />

        <TextView
            android:id="@+id/w_amb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/w_tile_off"
            android:textColor="@color/w_off_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Ambient" />

        <TextView
            android:id="@+id/w_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/w_tile_off"
            android:textColor="@color/w_off_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Off" />
    </LinearLayout>
</LinearLayout>

