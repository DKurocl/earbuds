<?xml version="1.0" encoding="utf-8"?>
<!-- Status 2×2: a big ring for the emptier earbud, the current mode under it, then how long it lasts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:padding="@dimen/w_pad">
<LinearLayout android:id="@+id/w_group"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
    android:gravity="center_horizontal" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_left"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical">
            <FrameLayout android:id="@+id/w_left_box"
                android:layout_width="88dp" android:layout_height="88dp">
                <ProgressBar android:id="@+id/w_left_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/w_ring" />
                <ImageView android:id="@+id/w_left_art"
                    android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center"
                    android:background="@drawable/w_disc" android:scaleType="fitCenter"
                    android:importantForAccessibility="no" android:src="@drawable/w_glyph_bud_left" android:tint="@color/w_glyph" />
                <ImageView android:id="@+id/w_left_charge"
                    android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/w_badge" android:padding="3dp" android:scaleType="fitCenter"
                    android:importantForAccessibility="no" android:src="@drawable/w_icon_bolt" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/w_left_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                android:singleLine="true" android:textSize="17sp" android:textColor="@color/w_off_text"
                android:gravity="center_vertical" android:text="@string/w_unknown" />
            <TextView android:id="@+id/w_left_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingTop="2dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
                android:importantForAccessibility="no" android:text="@string/w_earbuds" />
        </LinearLayout>
    <LinearLayout android:id="@+id/w_mode"
        android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="8dp"
        android:background="@drawable/w_mode_chip" android:paddingHorizontal="12dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_mode_icon" android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/w_icon_anc_bold" android:tint="@color/w_on_text" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_mode_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
            android:singleLine="true" android:textSize="13sp" android:textColor="@color/w_on_text" />
    </LinearLayout>
    <TextView android:id="@+id/w_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
        android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text" />
</LinearLayout>
</FrameLayout>
