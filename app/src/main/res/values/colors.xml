<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: follow the wallpaper (dynamic color). -->
<resources>
    <color name="w_bg">@android:color/system_accent2_50</color>
    <color name="w_on">@android:color/system_accent1_600</color>
    <color name="w_on_text">@android:color/system_accent1_0</color>
    <color name="w_off_text">@android:color/system_accent2_900</color>
    <color name="w_sub_text">@android:color/system_neutral2_700</color>
    <color name="w_track">@android:color/system_neutral2_200</color>
    <!-- Battery rings follow the wallpaper like Pixel's own battery widget; only low is red. -->
    <color name="w_ring">@android:color/system_accent1_600</color>
    <color name="w_low">#FFB3261E</color>
    <color name="w_unknown">@android:color/system_neutral2_300</color>
    <color name="w_on_ring">@android:color/system_accent1_0</color>
    <color name="w_disc_fill">@android:color/system_accent1_100</color>
    <color name="w_glyph">@android:color/system_accent1_700</color>
    <!-- The mode bar in the wallpaper's tones: a tinted surface (accent2), primary for the chosen
         mode, and tertiary (accent3) for the app button, so the widget is never plain grey. -->
    <color name="w_bar">@android:color/system_accent2_50</color>
    <!-- A mode segment at rest: one tone up from the bar. -->
    <color name="w_seg">@android:color/system_accent2_100</color>
    <color name="w_bar_on">@android:color/system_primary_light</color>
    <color name="w_bar_on_text">@android:color/system_on_primary_light</color>
    <color name="w_bar_text">@android:color/system_accent2_900</color>
    <!-- Each mode's own color, as the app's toolbar shows it: ANC primary, Ambient tertiary, Off secondary. -->
    <color name="w_anc_on">@color/w_bar_on</color>
    <color name="w_anc_on_text">@color/w_bar_on_text</color>
    <color name="w_amb_on">@android:color/system_accent3_600</color>
    <color name="w_amb_on_text">@android:color/system_accent3_0</color>
    <color name="w_off_on">@android:color/system_accent2_600</color>
    <color name="w_off_on_text">@android:color/system_accent2_0</color>
</resources>
