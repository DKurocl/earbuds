<?xml version="1.0" encoding="utf-8"?>
<!-- Widget mode change: the chosen pill fades in with a small expressive pop. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in" android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <scale android:fromXScale="0.88" android:toXScale="1" android:fromYScale="0.88" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="320"
        android:interpolator="@android:interpolator/overshoot" />
</set>
