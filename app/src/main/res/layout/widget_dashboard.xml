<?xml version="1.0" encoding="utf-8"?>
<!-- Large slots (lock screen hub, 4×2 and up): status, batteries, estimate, modes and scenes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
<LinearLayout android:id="@+id/w_group"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="google-sans-text-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textSize="16sp" android:textColor="@color/w_off_text" android:text="@string/w_device" />
        <TextView android:id="@+id/w_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="8dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
            android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_batteries" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/w_left"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_left_box"
                android:layout_width="44dp" android:layout_height="44dp">
                <ProgressBar android:id="@+id/w_left_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/w_ring" />
                <ImageView android:id="@+id/w_left_art"
                    android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center"
                    android:background="@drawable/w_disc" android:scaleType="fitCenter"
                    android:importantForAccessibility="no" android:src="@drawable/wf1000xm5_bud" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:orientation="vertical" tools:ignore="RtlSymmetry">
                <TextView android:id="@+id/w_left_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="15sp" android:textColor="@color/w_off_text"
                    android:drawablePadding="2dp" android:gravity="center_vertical" android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_left_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="2dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
                    android:importantForAccessibility="no" android:text="@string/w_left" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_case"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_case_box"
                android:layout_width="44dp" android:layout_height="44dp">
                <ProgressBar android:id="@+id/w_case_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/w_ring" />
                <ImageView android:id="@+id/w_case_art"
                    android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center"
                    android:background="@drawable/w_disc" android:scaleType="fitCenter"
                    android:importantForAccessibility="no" android:src="@drawable/wf1000xm5_case" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:orientation="vertical" tools:ignore="RtlSymmetry">
                <TextView android:id="@+id/w_case_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="15sp" android:textColor="@color/w_off_text"
                    android:drawablePadding="2dp" android:gravity="center_vertical" android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_case_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="2dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
                    android:importantForAccessibility="no" android:text="@string/w_case" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_right"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_right_box"
                android:layout_width="44dp" android:layout_height="44dp">
                <ProgressBar android:id="@+id/w_right_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/w_ring" />
                <ImageView android:id="@+id/w_right_art"
                    android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center"
                    android:background="@drawable/w_disc" android:scaleType="fitCenter"
                    android:importantForAccessibility="no" android:src="@drawable/wf1000xm5_bud_mirrored" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:orientation="vertical" tools:ignore="RtlSymmetry">
                <TextView android:id="@+id/w_right_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="15sp" android:textColor="@color/w_off_text"
                    android:drawablePadding="2dp" android:gravity="center_vertical" android:text="@string/w_unknown" />
                <TextView android:id="@+id/w_right_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="2dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
                    android:singleLine="true" android:textSize="12sp" android:textColor="@color/w_sub_text"
                    android:importantForAccessibility="no" android:text="@string/w_right" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_estimate"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="google-sans-text" android:includeFontPadding="false"
        android:singleLine="true" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/w_sub_text" />
    <LinearLayout android:id="@+id/w_modes" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/w_anc"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_tile_start">
            <ImageView android:id="@+id/w_anc_icon"
                android:layout_width="24dp" android:layout_height="24dp"
                android:importantForAccessibility="no" android:src="@drawable/w_icon_noise_control_off" />
            <TextView android:id="@+id/w_anc_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                android:singleLine="true" android:importantForAccessibility="no"
                android:textSize="14sp" android:textColor="@color/w_off_text" android:text="@string/shortcut_anc"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_amb"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_tile_middle">
            <ImageView android:id="@+id/w_amb_icon"
                android:layout_width="24dp" android:layout_height="24dp"
                android:importantForAccessibility="no" android:src="@drawable/w_icon_hearing" />
            <TextView android:id="@+id/w_amb_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                android:singleLine="true" android:importantForAccessibility="no"
                android:textSize="14sp" android:textColor="@color/w_off_text" android:text="@string/shortcut_ambient"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_off"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="8dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_tile_end">
            <ImageView android:id="@+id/w_off_icon"
                android:layout_width="24dp" android:layout_height="24dp"
                android:importantForAccessibility="no" android:src="@drawable/w_icon_power_settings_new" />
            <TextView android:id="@+id/w_off_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:fontFamily="google-sans-text-medium" android:includeFontPadding="false"
                android:singleLine="true" android:importantForAccessibility="no"
                android:textSize="14sp" android:textColor="@color/w_off_text" android:text="@string/shortcut_off"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_scenes" android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w_scene0"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:paddingHorizontal="10dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_chip"
            android:fontFamily="google-sans-text-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/w_off_text" />
        <TextView android:id="@+id/w_scene1"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:gravity="center" android:paddingHorizontal="10dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_chip"
            android:fontFamily="google-sans-text-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/w_off_text" />
        <TextView android:id="@+id/w_scene2"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/w_gap"
            android:gravity="center" android:paddingHorizontal="10dp"
            android:clickable="true" android:focusable="true" android:background="@drawable/w_chip"
            android:fontFamily="google-sans-text-medium" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/w_off_text" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
