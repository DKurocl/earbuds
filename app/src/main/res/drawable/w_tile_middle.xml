<?xml version="1.0" encoding="utf-8"?>
<!-- Connected button group segment: full outer corners, tight inner corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/w_ripple">
    <item><shape android:shape="rectangle"><solid android:color="@color/w_off" /><corners android:topLeftRadius="8dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="8dp" /></shape></item>
    <item android:id="@android:id/mask"><shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:topLeftRadius="8dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="8dp" /></shape></item>
</ripple>
