<?xml version="1.0" encoding="utf-8"?>
<!-- Three-position switch: a pill track, a knob on the current mode. A position sets that mode;
     anywhere else opens the app. The knob fades across (layout transitions); widgets take no drags. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:padding="@dimen/w_pad">
<LinearLayout android:id="@+id/w_group"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/w_track"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@drawable/w_track_pill" android:padding="4dp"
        android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/w_anc"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:animateLayoutChanges="true">
            <ImageView android:id="@+id/w_anc_knob" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center" android:src="@drawable/w_knob" android:visibility="gone"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_anc_glyph" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:src="@drawable/w_icon_anc" android:tint="@color/w_off_text"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_amb"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:animateLayoutChanges="true">
            <ImageView android:id="@+id/w_amb_knob" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center" android:src="@drawable/w_knob" android:visibility="gone"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_amb_glyph" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:src="@drawable/w_icon_ambient" android:tint="@color/w_off_text"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_off"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:animateLayoutChanges="true">
            <ImageView android:id="@+id/w_off_knob" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center" android:src="@drawable/w_knob" android:visibility="gone"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_off_glyph" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:src="@drawable/w_icon_off" android:tint="@color/w_off_text"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_names"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_anc_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:fontFamily="google-sans-text-medium" android:textSize="13sp"
            android:includeFontPadding="false" android:singleLine="true" android:textColor="@color/w_sub_text"
            android:importantForAccessibility="no" android:text="@string/shortcut_anc" />
        <TextView android:id="@+id/w_amb_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:fontFamily="google-sans-text-medium" android:textSize="13sp"
            android:includeFontPadding="false" android:singleLine="true" android:textColor="@color/w_sub_text"
            android:importantForAccessibility="no" android:text="@string/shortcut_ambient" />
        <TextView android:id="@+id/w_off_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:fontFamily="google-sans-text-medium" android:textSize="13sp"
            android:includeFontPadding="false" android:singleLine="true" android:textColor="@color/w_sub_text"
            android:importantForAccessibility="no" android:text="@string/shortcut_off" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
